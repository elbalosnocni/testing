/** KIEM TRA CHAM CONG - Google Apps Script V1
 * RAW_LOG khong bi sua/xoa. Dung Ma Nhan Vien lam khoa AC/MSVT.
 * Tre/som chi tinh khi ca trong CA_THUC_TE da Xac Nhan=YES.
 * Thieu quet/ca chua xac nhan -> XAC_MINH.
 */
const CC={RAW:'RAW_LOG',RULES:'RULES',SHIFT:'CA_THUC_TE',RESULT:'KET_QUA',VERIFY:'XAC_MINH',LOG:'LOG_AUTO',LEGACY:['Ăn quá giờ','Trễ sớm','Xác nhận lỗi']};
const RAW_H=['Ten May Cham Cong','Ma Nhan Vien','Thoi Gian Bam Gio','Ghi Chu'];
const SHIFT_H=['Ngay','MSVT','Ho Ten','Gio Vao Ca','Gio Ra Ca','Loai Ca','Xac Nhan','Ghi Chu'];
const RESULT_H=['Khoa','Ngay','MSVT','Ho Ten','Ca','Gio Vao Du Kien','Gio Ra Du Kien','Gio Quet Dau','Gio Quet Cuoi','Tre Phut','Som Phut','So Luot Quet','An Qua Gio Phut','Tru Cong Phut','Lap Bien Ban','Trang Thai','Ly Do / Ghi Chu','Cap Nhat Luc'];
const VERIFY_H=['Khoa','Ngay','MSVT','Ho Ten','Loai Can Xac Minh','Chi Tiet','Trang Thai Xac Minh','Nguoi Xac Nhan','Ghi Chu Xac Minh','Cap Nhat Luc'];
function onOpen(){SpreadsheetApp.getUi().createMenu('Cham cong tu dong').addItem('1. Tao / kiem tra cac tab','setupChamCong').addItem('2. Chay kiem tra','runChamCong').addItem('3. Tao trigger moi gio','createHourlyTrigger').addToUi();}
function setupChamCong(){const ss=SpreadsheetApp.getActive();ensure_(ss,CC.RAW,RAW_H);ensure_(ss,CC.RULES,['Tham So','Gia Tri','Mo Ta']);ensure_(ss,CC.SHIFT,SHIFT_H);ensure_(ss,CC.RESULT,RESULT_H);ensure_(ss,CC.VERIFY,VERIFY_H);ensure_(ss,CC.LOG,['Thoi Gian','Cap Do','Su Kien','Chi Tiet']);setupRules_();format_();log_('INFO','SETUP','Da tao/kiem tra cac tab.');SpreadsheetApp.getUi().alert('Da chuan bi xong. Nhap log vao RAW_LOG, lich ca vao CA_THUC_TE, kiem tra RULES.');}
function setupRules_(){const sh=SpreadsheetApp.getActive().getSheetByName(CC.RULES);const defaults=[['TRE_SOM_NGUONG_PHUT',10,'Tu du 10 phut'],['TRE_SOM_TRU_CONG_PHUT',30,'Muc co ban'],['TRE_SOM_LAM_TRON_TU_PHUT',40,'Tren 40 phut tinh 60'],['AN_QUA_BIEN_BAN_TU_PHUT',5,'Qua tren 5 phut lap bien ban'],['AN_QUA_TRU_CONG_TU_PHUT',10,'Tu du 10 phut tinh tru cong'],['AN_QUA_LAM_TRON_TU_PHUT',45,'Tren 45 phut tinh 60'],['AN_QUA_TRU_CO_BAN_PHUT',30,'Tu 10 den 45 phut tru 30'],['DUPLICATE_SECONDS',2,'Quet cach nhau <= 2 giay nghi trung'],['WINDOW1_START','08:30','Ca 1/Hanh chinh'],['WINDOW1_END','13:00','Ca 1/Hanh chinh'],['WINDOW1_ALLOWED_MIN',30,'Phut nghi cho phep'],['WINDOW2_START','15:30','Ca 2'],['WINDOW2_END','19:00','Ca 2'],['WINDOW2_ALLOWED_MIN',30,'Phut nghi cho phep'],['WINDOW3_START','20:30','Phu'],['WINDOW3_END','23:00','Phu'],['WINDOW3_ALLOWED_MIN',30,'Phut nghi cho phep'],['WINDOW4_START','00:30','Ca 3'],['WINDOW4_END','04:30','Ca 3 qua dem'],['WINDOW4_ALLOWED_MIN',45,'Phut nghi cho phep'],['AUTO_APPEND_LEGACY_REPORTS','YES','YES bo sung tab cu neu co'],['TIMEZONE','Asia/Ho_Chi_Minh','Mui gio']];const old=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,1).getDisplayValues().flat():[];const have=new Set(old.map(String));const add=defaults.filter(r=>!have.has(r[0]));if(add.length)sh.getRange(sh.getLastRow()+1,1,add.length,3).setValues(add);}
function runChamCong(){const lock=LockService.getDocumentLock();if(!lock.tryLock(20000))throw Error('Dang co phien kiem tra khac.');try{setupMissing_();const ss=SpreadsheetApp.getActive(),cfg=rules_(),raw=table_(ss.getSheetByName(CC.RAW));if(!raw.rows.length){log_('WARN','NO_RAW','RAW_LOG chua co du lieu.');return;}const ix=map_(raw.headers),cCode=col_(ix,['manhanvien','msvt','ac','macongnhan']),cTime=col_(ix,['thoigianbamgio','thoigian','datetime','timestamp','punchtime','ngaygiobam']);if(cCode<0||cTime<0)throw Error('RAW_LOG can co cot Ma Nhan Vien va Thoi Gian Bam Gio.');const punches=[],exact=new Set();raw.rows.forEach(r=>{const code=String(r[cCode]||'').trim(),dt=parseDate_(r[cTime]);if(!code||!dt)return;const k=code+'|'+dt.getTime();if(exact.has(k))return;exact.add(k);punches.push({code,dt,day:key_(dt)});});punches.sort((a,b)=>a.code.localeCompare(b.code)||a.dt-b.dt);const shifts=readShifts_(ss.getSheetByName(CC.SHIFT)),groups={};punches.forEach(p=>{const k=p.day+'|'+p.code;(groups[k]=groups[k]||[]).push(p);});const result=[],verify=[],mealRows=[],lateRows=[],now=new Date(),processed=new Set();Object.keys(groups).forEach(k=>{const parts=k.split('|'),day=parts[0],code=parts[1],shift=shifts[k],ps=groups[k];processed.add(k);const r=analyze_(day,code,ps,shift,cfg,now);result.push(r.result);r.verify.forEach(x=>verify.push(x));r.meals.forEach(x=>mealRows.push(x));if(r.late)lateRows.push(r.late);});
// Ca qua dem: gan log sau nua dem vao ca da bat dau ngay truoc neu shift co thoi gian ket thuc ngay sau.
Object.keys(shifts).forEach(k=>{if(processed.has(k))return;const sh=shifts[k];const day=k.split('|')[0],code=k.split('|')[1];const ps=punches.filter(p=>p.code===code&&(p.day===day||(p.day===addDays_(day,1)&&p.dt.getHours()<8)));const r=analyze_(day,code,ps,sh,cfg,now);result.push(r.result);r.verify.forEach(x=>verify.push(x));r.meals.forEach(x=>mealRows.push(x));if(r.late)lateRows.push(r.late);});
upsert_(ss.getSheetByName(CC.RESULT),RESULT_H,result);upsert_(ss.getSheetByName(CC.VERIFY),VERIFY_H,verify);if(String(cfg.AUTO_APPEND_LEGACY_REPORTS||'YES').toUpperCase()==='YES'){appendLegacy_(ss,'Ăn quá giờ',mealRows,['Khoa','Ngay','MSVT','Ho Ten','Gio Ra Nghi','Gio Vao Lai','So Phut An Qua','Tru Cong Phut','Lap Bien Ban','Trang Thai']);appendLegacy_(ss,'Trễ sớm',lateRows,['Khoa','Ngay','MSVT','Ho Ten','Gio Vao Du Kien','Gio Quet Dau','Tre Phut','Gio Ra Du Kien','Gio Quet Cuoi','Som Phut','Tru Cong Phut','Trang Thai']);appendLegacy_(ss,'Xác nhận lỗi',verify.map(v=>({'Khoa':v[0],'Ngay':v[1],'MSVT':v[2],'Ho Ten':v[3],'Loai Can Xac Minh':v[4],'Chi Tiet':v[5],'Trang Thai Xac Minh':v[6]})),['Khoa','Ngay','MSVT','Ho Ten','Loai Can Xac Minh','Chi Tiet','Trang Thai Xac Minh']);}log_('INFO','RUN_OK',`Da xu ly ${punches.length} luot quet; ${result.length} ket qua; ${verify.length} muc can xac minh.`);}catch(e){log_('ERROR','RUN_FAIL',e.stack||String(e));throw e;}finally{lock.releaseLock();}}
function analyze_(day,code,ps,shift,cfg,now){ps.sort((a,b)=>a.dt-b.dt);const first=ps.length?ps[0].dt:null,last=ps.length?ps[ps.length-1].dt:null,name=shift?shift.name:'',verify=[],meals=[];let late=0,early=0,deduct=0,mealOver=0,incident='KHONG',notes=[];for(let i=1;i<ps.length;i++){const sec=(ps[i].dt-ps[i-1].dt)/1000;if(sec<=Number(cfg.DUPLICATE_SECONDS||2))verify.push(vrow_(day,code,name,'QUET NGHI TRUNG',`Hai lan quet cach nhau ${Math.round(sec)} giay: ${fmt_(ps[i-1].dt)} va ${fmt_(ps[i].dt)}`,now));}
if(!shift||!shift.confirmed){verify.push(vrow_(day,code,name,shift?'CA CHUA XAC NHAN':'CHUA CO LICH CA',shift?'CA_THUC_TE chua co Xac Nhan=YES.':'Khong co lich ca thuc te; khong tu ket luan tre/som.',now));if(ps.length<2)verify.push(vrow_(day,code,name,'THIEU LUOT QUET',`Chi co ${ps.length} luot quet; can xac minh.`,now));}else if(ps.length<2){verify.push(vrow_(day,code,name,'THIEU LUOT QUET',`Chi co ${ps.length} luot quet; khong tu suy doan gio vao/ra.`,now));notes.push('Thieu luot quet');}else{late=Math.max(0,Math.floor((first-shift.start)/60000));early=Math.max(0,Math.floor((shift.end-last)/60000));if(late>=Number(cfg.TRE_SOM_NGUONG_PHUT||10)){deduct+=late>Number(cfg.TRE_SOM_LAM_TRON_TU_PHUT||40)?60:Number(cfg.TRE_SOM_TRU_CONG_PHUT||30);notes.push('Tre '+late+' phut');}if(early>=Number(cfg.TRE_SOM_NGUONG_PHUT||10)){deduct+=early>Number(cfg.TRE_SOM_LAM_TRON_TU_PHUT||40)?60:Number(cfg.TRE_SOM_TRU_CONG_PHUT||30);notes.push('Som '+early+' phut');}}
const windows=[1,2,3,4].map(n=>({n,start:cfg['WINDOW'+n+'_START'],end:cfg['WINDOW'+n+'_END'],allowed:Number(cfg['WINDOW'+n+'_ALLOWED_MIN']||30)}));for(let i=1;i<ps.length;i++){const a=ps[i-1].dt,b=ps[i].dt,w=windows.find(x=>inWin_(a,x.start,x.end)&&inWin_(b,x.start,x.end));if(!w||b<=a)continue;const duration=Math.round((b-a)/60000),over=duration-w.allowed;if(over<=5)continue;const d=over>=Number(cfg.AN_QUA_TRU_CONG_TU_PHUT||10)?(over>Number(cfg.AN_QUA_LAM_TRON_TU_PHUT||45)?60:Number(cfg.AN_QUA_TRU_CO_BAN_PHUT||30)):0;const inc=over>Number(cfg.AN_QUA_BIEN_BAN_TU_PHUT||5)?'CO':'KHONG';const detail='Cap quet trong cua so '+w.n+'; can xac nhan dung la giai lao';meals.push([day+'|'+code+'|AN|'+w.n+'|'+a.getTime(),date_(day),code,name,a,b,over,d,inc,detail]);mealOver=Math.max(mealOver,over);deduct+=d;if(inc==='CO')incident='CO';}
// Quet trong cua so nhung khong co cap cung cua so -> cho xac minh, khong tinh thoi gian.
ps.forEach(p=>{if(!windows.some(w=>inWin_(p.dt,w.start,w.end)))return;const paired=ps.some(q=>q!==p&&Math.abs(q.dt-p.dt)<8*3600000&&windows.some(w=>inWin_(p.dt,w.start,w.end)&&inWin_(q.dt,w.start,w.end)));if(!paired)verify.push(vrow_(day,code,name,'GIO NGHI THIEU CAP QUET','Co quet trong cua so giai lao nhung khong tim thay cap quet ra/vao; khong tinh qua gio.',now));});
let status='KHONG PHAT HIEN';if(verify.length)status='CHO XAC MINH';if(deduct>0||late>=10||early>=10)status='CO VI PHAM - CHO CHOT';const result=[day+'|'+code,date_(day),code,name,shift?shift.type:'',shift?shift.start:'',shift?shift.end:'',first||'',last||'',late,early,ps.length,mealOver,deduct,incident,status,notes.concat(verify.map(v=>v[4]+': '+v[5])).join(' | '),now];let lateRow=null;if(late||early)lateRow={'Khoa':day+'|'+code+'|TRE_SOM','Ngay':date_(day),'MSVT':code,'Ho Ten':name,'Gio Vao Du Kien':shift?shift.start:'','Gio Quet Dau':first||'','Tre Phut':late,'Gio Ra Du Kien':shift?shift.end:'','Gio Quet Cuoi':last||'','Som Phut':early,'Tru Cong Phut':deduct,'Trang Thai':'CHO XAC NHAN'};return{result,verify,meals,late:lateRow};}
function readShifts_(sh){const t=table_(sh),m=map_(t.headers),cDate=col_(m,['ngay','date']),cCode=col_(m,['msvt','manhanvien','ac']),cName=col_(m,['hoten','tennhanvien','name']),cStart=col_(m,['giovaoca','giovao','shiftstart']),cEnd=col_(m,['gioraca','giora','shiftend']),cType=col_(m,['loaica','ca','shifttype']),cConf=col_(m,['xacnhan','confirmed','duyet']);const out={};if([cDate,cCode,cStart,cEnd].some(x=>x<0))return out;t.rows.forEach(r=>{const d=parseDate_(r[cDate]),code=String(r[cCode]||'').trim();if(!d||!code)return;const day=key_(d),start=combine_(day,r[cStart]),end=combine_(day,r[cEnd]);if(!start||!end)return;if(end<=start)end.setDate(end.getDate()+1);out[day+'|'+code]={day,code,name:cName>=0?String(r[cName]||''):'',start,end,type:cType>=0?String(r[cType]||''):'',confirmed:cConf>=0&&['YES','Y','CO','DA XAC NHAN','1','TRUE'].includes(String(r[cConf]||'').trim().toUpperCase())};});return out;}
function upsert_(sh,headers,rows){ensureHeaders_(sh,headers);if(!rows.length)return;const vals=sh.getDataRange().getValues(),hm=vals[0].map(norm_),kc=hm.indexOf(norm_('Khoa')),existing=new Map();for(let i=1;i<vals.length;i++){const k=kc>=0?String(vals[i][kc]||''):'';if(k)existing.set(k,i+1);}rows.forEach(r=>{const k=String(r[0]||''),at=existing.get(k);if(at)sh.getRange(at,1,1,headers.length).setValues([r]);else{sh.appendRow(r);existing.set(k,sh.getLastRow());}});}
function appendLegacy_(ss,name,objects,headers){const sh=ss.getSheetByName(name);if(!sh||!objects.length)return;let vals=sh.getDataRange().getDisplayValues();if(sh.getLastRow()===0||!vals.length||vals[0].every(x=>!String(x).trim())){sh.getRange(1,1,1,headers.length).setValues([headers]);vals=[headers];}const actual=vals[0].slice(0,headers.length).map(norm_),expected=headers.map(norm_);if(expected.some((h,i)=>actual[i]!==h)){log_('WARN','LEGACY_SKIP','Khong ghi vao tab '+name+' vi header khong khop; giu nguyen tab cu. Ket qua van co trong KET_QUA/XAC_MINH.');return;}const kc=actual.indexOf(norm_('Khoa')),keys=new Set();if(kc>=0)for(let i=1;i<vals.length;i++)keys.add(String(vals[i][kc]||''));objects.forEach(o=>{const row=headers.map(h=>{const k=Object.keys(o).find(x=>norm_(x)===norm_(h));return k?o[k]:'';});if(row[0]&&keys.has(String(row[0])))return;sh.appendRow(row);if(row[0])keys.add(String(row[0]));});}
function vrow_(day,code,name,type,detail,now){return[day+'|'+code+'|VERIFY|'+type+'|'+detail.slice(0,35),date_(day),code,name,type,detail,'CHO XAC MINH','','',now];}
function rules_(){const sh=SpreadsheetApp.getActive().getSheetByName(CC.RULES),v=sh.getDataRange().getValues(),o={};v.slice(1).forEach(r=>{if(r[0]!=='')o[String(r[0]).trim()]=r[1];});return o;}
function table_(sh){const v=sh.getDataRange().getValues();return{headers:v.length?v[0].map(x=>String(x||'').trim()):[],rows:v.slice(1).filter(r=>r.some(x=>x!==''&&x!=null))};}
function ensure_(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);ensureHeaders_(sh,headers);return sh;}
function ensureHeaders_(sh,headers){if(!sh.getLastRow()||!sh.getLastColumn()){sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);return;}const cur=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0],norm=cur.map(norm_);if(cur.every(x=>!String(x).trim())){sh.getRange(1,1,1,headers.length).setValues([headers]);return;}const missing=headers.filter(h=>!norm.includes(norm_(h)));if(missing.length)sh.getRange(1,sh.getLastColumn()+1,1,missing.length).setValues([missing]);}
function setupMissing_(){const ss=SpreadsheetApp.getActive();ensure_(ss,CC.RAW,RAW_H);ensure_(ss,CC.RULES,['Tham So','Gia Tri','Mo Ta']);ensure_(ss,CC.SHIFT,SHIFT_H);ensure_(ss,CC.RESULT,RESULT_H);ensure_(ss,CC.VERIFY,VERIFY_H);ensure_(ss,CC.LOG,['Thoi Gian','Cap Do','Su Kien','Chi Tiet']);}
function format_(){Object.values({a:CC.RAW,b:CC.RULES,c:CC.SHIFT,d:CC.RESULT,e:CC.VERIFY,f:CC.LOG}).forEach(n=>{const s=SpreadsheetApp.getActive().getSheetByName(n);if(s){s.setFrozenRows(1);s.getRange(1,1,1,s.getLastColumn()).setFontWeight('bold').setWrap(true);}});}
function createHourlyTrigger(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='runChamCong').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('runChamCong').timeBased().everyHours(1).create();SpreadsheetApp.getUi().alert('Da tao trigger chay moi gio.');}
function log_(level,event,detail){const ss=SpreadsheetApp.getActive();let sh=ss.getSheetByName(CC.LOG);if(!sh)sh=ensure_(ss,CC.LOG,['Thoi Gian','Cap Do','Su Kien','Chi Tiet']);sh.appendRow([new Date(),level,event,detail]);}
function map_(h){const o={};h.forEach((x,i)=>o[norm_(x)]=i);return o;}function col_(m,a){for(const x of a){const k=norm_(x);if(Object.prototype.hasOwnProperty.call(m,k))return m[k];}return-1;}
function norm_(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/[^a-z0-9]/g,'');}
function parseDate_(v){if(v instanceof Date&&!isNaN(v))return new Date(v);if(typeof v==='number'&&isFinite(v))return new Date(Math.round((v-25569)*86400000));const s=String(v||'').trim();if(!s)return null;let m=s.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);if(m)return new Date(+m[3],+m[2]-1,+m[1],+(m[4]||0),+(m[5]||0),+(m[6]||0));const d=new Date(s);return isNaN(d)?null:d;}
function key_(d){return Utilities.formatDate(d,String(rules_().TIMEZONE||'Asia/Ho_Chi_Minh'),'yyyy-MM-dd');}function date_(k){const p=k.split('-').map(Number);return new Date(p[0],p[1]-1,p[2]);}function addDays_(k,n){const d=date_(k);d.setDate(d.getDate()+n);return key_(d);}
function combine_(day,v){const d=date_(day);if(v instanceof Date){d.setHours(v.getHours(),v.getMinutes(),v.getSeconds(),0);return d;}const m=String(v||'').match(/(\d{1,2}):(\d{2})(?::(\d{2}))?/);if(!m)return null;d.setHours(+m[1],+m[2],+(m[3]||0),0);return d;}
function inWin_(d,a,b){const m=d.getHours()*60+d.getMinutes(),x=clock_(a),y=clock_(b);if(x==null||y==null)return false;return y>=x?m>=x&&m<=y:m>=x||m<=y;}function clock_(s){const m=String(s||'').match(/^(\d{1,2}):(\d{2})$/);return m?+m[1]*60+ +m[2]:null;}function fmt_(d){return Utilities.formatDate(d,'Asia/Ho_Chi_Minh','HH:mm:ss');}
